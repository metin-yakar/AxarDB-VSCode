# Open VSX Personal Access Token (PAT)
# Alınan adres: https://open-vsx.org/user-settings/tokens
OVSX_PAT=your_open_vsx_token_here

# Visual Studio Marketplace PAT (Azure DevOps)
# Alınan adres: https://dev.azure.com (User Settings -> Personal access tokens)
# Önemli: Organization -> "All accessible organizations", Scopes -> "Marketplace (Manage)"
VSCE_PAT=your_azure_devops_vsce_token_here


